{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.invisra.ai/api-client/shared-tooling-pins-v1.schema.json",
  "title": "Invisra shared API client tooling pins v1",
  "type": "object",
  "required": ["schemaVersion", "pins"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {"const": 1},
    "pins": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "ref", "files"],
        "additionalProperties": false,
        "properties": {
          "name": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
          "ref": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
          "files": {
            "type": "array",
            "minItems": 1,
            "items": {
              "anyOf": [
                {"type": "string", "minLength": 1},
                {
                  "type": "object",
                  "required": ["path"],
                  "additionalProperties": false,
                  "properties": {
                    "path": {"type": "string", "minLength": 1},
                    "occurrences": {"type": "integer", "minimum": 1},
                    "minOccurrences": {"type": "integer", "minimum": 1}
                  }
                }
              ]
            }
          }
        }
      }
    }
  }
}
