{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "API client package metadata validation config",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "repository",
    "license",
    "typescript",
    "python"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "repository": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
    },
    "license": {
      "type": "string",
      "minLength": 1
    },
    "typescript": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "packageJson",
        "name"
      ],
      "properties": {
        "packageJson": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "python": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pyproject",
        "name"
      ],
      "properties": {
        "pyproject": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
