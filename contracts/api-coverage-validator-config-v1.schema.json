{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.invisra.ai/api-client/api-coverage-validator-config-v1.schema.json",
  "title": "Invisra API coverage validator config v1",
  "type": "object",
  "required": ["typescriptRoots", "pythonRoots", "conformanceVersion"],
  "additionalProperties": false,
  "properties": {
    "manifest": {"type": "string", "minLength": 1},
    "typescriptRoots": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "pythonRoots": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "conformanceVersion": {"type": "string", "minLength": 1},
    "requireHttpRoute": {"type": "boolean"},
    "inferredContractGuardSubstring": {"type": "string", "minLength": 1}
  }
}
