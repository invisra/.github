{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.invisra.ai/api-client/api-coverage-v2.schema.json",
  "title": "Invisra API client coverage manifest v2",
  "type": "object",
  "required": ["schemaVersion", "vendor", "verifiedAt", "sources", "operations"],
  "additionalProperties": true,
  "properties": {
    "schemaVersion": {"const": 2},
    "conformanceVersion": {"type": "string", "minLength": 1},
    "vendor": {"type": "string", "minLength": 1},
    "verifiedAt": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "sources": {"type": "array", "minItems": 1, "items": {"anyOf": [{"type": "string", "minLength": 1}, {"type": "object"}]}},
    "operations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "family", "operation", "typescript", "python", "confidence", "classification", "idempotency", "retryPolicy", "confirmationRequired"],
        "additionalProperties": true,
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "family": {"type": "string", "minLength": 1},
          "operation": {"type": "string", "minLength": 1},
          "method": {"type": ["string", "null"], "enum": ["GET", "POST", "PUT", "DELETE", "PATCH", "HEAD", "OPTIONS", null]},
          "path": {"type": ["string", "null"]},
          "typescript": {"type": "boolean"},
          "python": {"type": "boolean"},
          "confidence": {"enum": ["official-public", "public-documented", "cross-referenced", "inferred-contract", "caller-verified", "portal-gated"]},
          "classification": {"enum": ["read", "mutation", "consequential", "unknown"]},
          "idempotency": {"enum": ["idempotent", "non-idempotent", "unknown"]},
          "retryPolicy": {"enum": ["safe", "none", "explicit"]},
          "confirmationRequired": {"type": "boolean"},
          "experimental": {"type": "boolean"},
          "typescriptSymbol": {"type": "string", "minLength": 1},
          "pythonSymbol": {"type": "string", "minLength": 1},
          "guard": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
