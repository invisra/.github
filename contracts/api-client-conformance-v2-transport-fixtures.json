{
  "fixtureVersion": 4,
  "conformanceVersion": "2.0",
  "lifecycle": {
    "phases": ["request", "response", "retry", "error"],
    "outcomes": ["not-sent", "known", "unknown"]
  },
  "urlSanitization": {
    "input": "https://example.test/items?apiKey=secret#section",
    "expected": "https://example.test/items"
  },
  "observer": {
    "phase": "request",
    "method": "GET",
    "url": "https://example.test/items",
    "attempt": 1,
    "outcome": "not-sent",
    "failureMessage": "observer failure",
    "mustIsolateFailure": true,
    "mustBeImmutable": true
  },
  "apiError": {
    "message": "failed",
    "status": 429,
    "code": "RATE_LIMITED",
    "requestId": "req-123",
    "retryable": true,
    "retryAfterMs": 2000,
    "url": "https://example.test/items"
  },
  "timeout": {
    "message": "timed out",
    "timeoutMs": 250,
    "retryable": true
  },
  "numericValidation": {
    "timeout": {
      "valid": [0.001, 1, 30.5],
      "invalidKinds": ["zero", "negative", "boolean", "nan", "positive-infinity", "negative-infinity"],
      "mustBeFinite": true,
      "mustBePositive": true,
      "mustRejectBoolean": true
    },
    "maxRetries": {
      "valid": [0, 1, 3],
      "invalidKinds": ["negative", "boolean", "fractional", "nan", "positive-infinity", "negative-infinity"],
      "mustBeFinite": true,
      "mustBeInteger": true,
      "mustBeNonNegative": true,
      "mustRejectBoolean": true
    }
  },
  "cancellation": {
    "message": "cancelled",
    "retryable": false
  },
  "semanticRetry": {
    "retryableStatuses": [429, 502, 503, 504],
    "fallbackSafeMethods": ["GET", "HEAD", "OPTIONS"],
    "safeOperation": {
      "retryPolicy": "safe",
      "idempotency": "idempotent",
      "transientStatus": 503,
      "maxRetries": 1,
      "expectedAttempts": 2
    },
    "nonRetryingOperation": {
      "retryPolicy": "none",
      "transientStatus": 503,
      "maxRetries": 3,
      "expectedAttempts": 1
    }
  },
  "confirmation": {
    "confirmationRequired": true,
    "confirmationSupplied": false,
    "expectedAttempts": 0,
    "retryable": false,
    "expectedOutcome": "not-sent"
  },
  "unknownOutcome": {
    "retryPolicy": "none",
    "confirmationSupplied": true,
    "transportFailure": "connection reset after request transmission",
    "expectedAttempts": 1,
    "retryable": false,
    "expectedOutcome": "unknown",
    "requiresReconciliation": true
  }
}
