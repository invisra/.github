{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.invisra.ai/api-client/public-api-surface-v1.schema.json",
  "title": "Invisra API client public surface v1",
  "type": "object",
  "required": ["schemaVersion"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {"const": 1},
    "typescript": {
      "type": "object",
      "required": ["entrypoint", "required"],
      "additionalProperties": false,
      "properties": {
        "entrypoint": {"type": "string", "minLength": 1},
        "required": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Za-z_$][A-Za-z0-9_$]*$"}}
      }
    },
    "python": {
      "type": "object",
      "required": ["entrypoint", "required"],
      "additionalProperties": false,
      "properties": {
        "entrypoint": {"type": "string", "minLength": 1},
        "required": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Za-z_$][A-Za-z0-9_$]*$"}}
      }
    }
  }
}
